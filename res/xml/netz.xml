<?xml version="1.0" encoding="utf-8"?>
<!-- Nur verschluesselte Verbindungen, nur System-Zertifikate (keine Nutzer-CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
